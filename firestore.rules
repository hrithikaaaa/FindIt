rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Items collection: public read, authenticated or app users can create and update
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.title != null && request.resource.data.type in ['lost', 'found'];
      allow update, delete: if true;
    }

    // Claims collection: read by participants, write allowed for submissions and status updates
    match /claims/{claimId} {
      allow read, write: if true;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Users collection: user profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
